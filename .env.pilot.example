# ==============================================================================
# CẤU HÌNH MẪU DEPLOYMENT PILOT (DEP1)
# ==============================================================================
# LƯU Ý BẢO MẬT:
# - KHÔNG điền secret thật vào file này.
# - KHÔNG commit file .env chứa secret thật vào Git.
# - Phân tách rõ biến môi trường giữa Render Web API và Contabo AI Worker.
# ==============================================================================

# --- 1. CHẾ ĐỘ CHẠY & MẠNG ---
RAV_RUNTIME_MODE=deploy                 # local | deploy (app pilot là entry riêng src.rav.api.pilot:app)
PORT=8000
HOST=0.0.0.0
RAV_FRONTEND_ORIGIN=https://rav-web.onrender.com

# --- 2. STORAGE (AWS S3) ---
RAV_STORAGE_BACKEND=s3                  # local | s3
RAV_S3_BUCKET=your-bucket-name
RAV_S3_REGION=ap-southeast-1
RAV_PILOT_S3_PREFIX=pilot-rav26
# AWS credentials (Backend only, never expose to frontend)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# --- 3. IDENTITY & POSTGRESQL (SUPABASE) ---
RAV_JOB_BACKEND=supabase                # local | supabase
SUPABASE_URL=https://your-project.supabase.co
# Xác minh token người dùng: JWKS (RSA/EC), issuer <SUPABASE_URL>/auth/v1, audience authenticated (CONTRACTS §21.11).
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Chỉ khi project còn dùng khóa JWT HS256 legacy; KHÔNG điền secret API key vào đây.
SUPABASE_JWT_SECRET=
# Secret API key chỉ cho job embedding C1/C2 cũ ở backend; không dùng để xác minh token người dùng.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Postgres direct TLS: Render API dùng role rav_pilot_api, Contabo worker dùng role rav_pilot_worker.
DATABASE_URL=postgresql://rav_pilot_api:your-db-password@db.your-project.supabase.co:5432/postgres?sslmode=require
# Chỉ operator, máy riêng: role có quyền DDL để chạy scripts/pilot_migrate.py (không đặt trên Render/Contabo).
# RAV_PILOT_MIGRATE_DATABASE_URL=postgresql://postgres:...@db.your-project.supabase.co:5432/postgres?sslmode=require

# --- 4. WORKER GPU ORCHESTRATION (CONTABO WORKER ONLY) ---
# Chỉ cấu hình trên Contabo AI Worker, KHÔNG đưa lên Render Web API
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-key
RAV_CLIP_IMAGE_BACKEND=kaggle           # local | kaggle

# --- 5. HẠN MỨC QUOTA & ADMISSION ---
# Quota/slot nằm trong DB (rav_pilot_quota_policy + rav_pilot_resource_slot) do operator khai báo sau đo DEP1;
# cửa sổ quota cố định 4 giờ UTC, không cấu hình qua env. Thiếu policy → API trả 503 policy_unconfigured.
RAV_MAX_UPLOAD_MB=500
RAV_MAX_SNAPSHOT_ZIP_MB=256

# --- 6. WORKER ENTRY DEP4F (CONTABO ONLY) ---
# Explicit worker role; never use API DATABASE_URL as fallback.
RAV_PILOT_WORKER_DATABASE_URL=postgresql://rav_pilot_worker:your-worker-password@db.your-project.supabase.co:5432/postgres?sslmode=require
RAV_PILOT_WORKDIR=output/pilot-worker
RAV_PILOT_WORKER_POLL_S=1
RAV_PILOT_WORKER_RECONCILE_S=10
# Linux reads /proc/sys/kernel/random/boot_id. On Windows inject a UUID tied to
# the host boot (keep the same UUID across worker restarts during one boot).
# RAV_PILOT_HOST_BOOT_ID=
# DEP5a GPU (§21.14): có KAGGLE_API_TOKEN → worker bật queue GPU cho slot GPU (DB) thuộc account của token,
# mỗi slot một notebook private <account>/rav26-pilot-<slot_key>; snapshot quota mỗi RAV_PILOT_GPU_BUDGET_S giây (≤60).
# KAGGLE_API_TOKEN=
RAV_PILOT_DEPLOYMENT=pilot
RAV_PILOT_GPU_BUDGET_S=60
