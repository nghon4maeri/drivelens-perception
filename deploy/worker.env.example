# Copy to worker.env on Contabo, chmod 600. Never copy the operator .env.
RAV_PILOT_WORKER_DATABASE_URL=postgresql://rav_pilot_worker.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=require
RAV_S3_BUCKET=aiia-irish-coffee
RAV_PILOT_S3_PREFIX=pilot-rav26
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Initial release CPU/MEDIA only; do not include KAGGLE_API_TOKEN.
RAV_PILOT_WORKDIR=output/pilot-worker
# Trần tổng cache raw/model/feature trong workdir (byte); bỏ trống = không dọn (CONTRACTS §21.20 F4)
RAV_PILOT_CACHE_MAX_BYTES=
RAV_PILOT_DEPLOYMENT=pilot
RAV_PILOT_WORKER_POLL_S=1
RAV_PILOT_WORKER_RECONCILE_S=10
RAV_TRACE_ENABLED=true
# Model che PII ghim SHA-256 (CONTRACTS §21.8 DEP6); thiếu/sai → export FAILED pii_model_unavailable
RAV_PII_MODEL_DIR=data/models/pii
