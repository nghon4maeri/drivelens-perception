# API container only. Fill .env.api locally / equivalent Render environment; never commit real secrets.
PORT=8000
RAV_FRONTEND_ORIGIN=https://YOUR-WEB.onrender.com
DATABASE_URL=postgresql://rav_pilot_api:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
RAV_S3_BUCKET=YOUR-EXISTING-BUCKET
RAV_S3_REGION=ap-southeast-1
RAV_PILOT_S3_PREFIX=YOUR-PILOT-PREFIX
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Server-only read operations allowlist, comma-separated verified account UUIDs.
RAV_PILOT_OPERATOR_IDS=
RAV_TRACE_ENABLED=true
