# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- RAV dataset import (S4) ----
RAV_DATASETS_DIR=data/datasets
RAV_MAX_IMPORT_IMAGES=50000

# ---- Snapshot ZIP tam (S8) ----
RAV_MAX_SNAPSHOT_ZIP_MB=256

# CLIP image job: Kaggle mặc định; local chỉ khi chủ động chọn smoke/offline.
RAV_CLIP_IMAGE_BACKEND=kaggle
RAV_KAGGLE_KERNEL=  # tuỳ chọn; để trống tự tạo notebook private riêng và reuse trong output
RAV_CLIP_MAX_PAYLOAD_MB=256
RAV_CLIP_TIMEOUT_S=900
# KAGGLE_API_TOKEN= (không ghi token vào log)

# Kho checkpoint tham chiếu (M1); chỉ lưu/kiểm file, chưa chạy YOLO.
RAV_MODELS_DIR=data/models
RAV_MAX_MODEL_MB=500


KAGGLE_API_TOKEN=
AWS_ACCESS_KEY_ID=gia_tri_Access_key_ID
AWS_SECRET_ACCESS_KEY=gia_tri_Secret_access_key
AWS_DEFAULT_REGION=

# C1 backend-only storage/job configuration; never put these in src/web or VITE_*.
RAV_STORAGE_BACKEND=local
RAV_S3_BUCKET=
RAV_JOB_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RAV_CLOUD_JOB_TIMEOUT_S=7200
